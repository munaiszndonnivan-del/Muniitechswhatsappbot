import { createRequire } from 'node:module';

const DEPARTMENT = 'hosting-server';
const OWNER = ['owner'];
const USER = ['user'];

const require = createRequire(
  path.join(process.cwd(), 'package.json')
);

function makeCommand(name, description, execute, permissions = USER) {
  return { name, description, department: DEPARTMENT, permissions, execute };
}

function getArgs(ctx) {
  return (ctx.args ?? [])
    .map(value => String(value).trim())
    .filter(Boolean);
}

function formatBytes(bytes) {
  if (!Number.isFinite(Number(bytes))) return 'Unavailable';

  const units = ['B', 'KB', 'MB', 'GB', 'TB'];
  let value = Number(bytes);
  let index = 0;

  while (value >= 1024 && index < units.length - 1) {
    value /= 1024;
    index++;
  }

  return `${value.toFixed(index === 0 ? 0 : 2)} ${units[index]}`;
}

function formatDuration(seconds) {
  const total = Math.floor(Math.max(0, seconds));
  const days = Math.floor(total / 86400);
  const hours = Math.floor((total % 86400) / 3600);
  const minutes = Math.floor((total % 3600) / 60);
  const remainingSeconds = total % 60;

  return [
    days ? `${days}d` : null,
    hours ? `${hours}h` : null,
    minutes ? `${minutes}m` : null,
    `${remainingSeconds}s`
  ].filter(Boolean).join(' ');
}

function validPort(value) {
  const port = Number(value);

  if (!Number.isInteger(port) || port < 1 || port > 65535) {
    throw new Error('Provide a valid port number between 1 and 65535.');
  }

  return port;
}

function validHostname(value) {
  const hostname = String(value ?? '').trim().toLowerCase();

  if (
    !hostname ||
    hostname.length > 253 ||
    hostname.includes('://') ||
    hostname.includes('/') ||
    hostname.includes('@') ||
    hostname.includes(':') ||
    hostname.includes(' ')
  ) {
    throw new Error('Provide a valid hostname, such as example.com.');
  }

  if (net.isIP(hostname)) return hostname;

  const labels = hostname.replace(/\.$/, '').split('.');

  if (
    labels.length < 2 ||
    labels.some(label =>
      label.length < 1 ||
      label.length > 63 ||
      !/^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$/i.test(label)
    )
  ) {
    throw new Error('That hostname does not have a valid domain format.');
  }

  return hostname;
}

function ipv4ToNumber(address) {
  const parts = address.split('.').map(Number);

  if (
    parts.length !== 4 ||
    parts.some(part => !Number.isInteger(part) || part < 0 || part > 255)
  ) {
    return null;
  }

  return (
    parts[0] * 16777216 +
    parts[1] * 65536 +
    parts[2] * 256 +
    parts[3]
  );
}

function inIPv4Range(address, network, prefix) {
  const ip = ipv4ToNumber(address);
  const base = ipv4ToNumber(network);

  if (ip === null || base === null) return false;

  const blockSize = 2 ** (32 - prefix);
  return Math.floor(ip / blockSize) === Math.floor(base / blockSize);
}

function expandIPv6(address) {
  let value = address.toLowerCase();

  if (value.includes('.')) return null;

  if ((value.match(/::/g) ?? []).length > 1) return null;

  if (value.includes('::')) {
    const [leftText, rightText] = value.split('::');
    const left = leftText ? leftText.split(':') : [];
    const right = rightText ? rightText.split(':') : [];
    const missing = 8 - left.length - right.length;

    if (missing < 1) return null;

    value = [...left, ...Array(missing).fill('0'), ...right].join(':');
  }

  const groups = value.split(':');

  if (
    groups.length !== 8 ||
    groups.some(group => !/^[0-9a-f]{1,4}$/.test(group))
  ) {
    return null;
  }

  return groups.map(group => parseInt(group, 16));
}

function isPublicAddress(address) {
  const version = net.isIP(address);

  if (version === 4) {
    const blockedRanges = [
      ['0.0.0.0', 8],
      ['10.0.0.0', 8],
      ['100.64.0.0', 10],
      ['127.0.0.0', 8],
      ['169.254.0.0', 16],
      ['172.16.0.0', 12],
      ['192.0.0.0', 24],
      ['192.0.2.0', 24],
      ['192.88.99.0', 24],
      ['192.168.0.0', 16],
      ['198.18.0.0', 15],
      ['198.51.100.0', 24],
      ['203.0.113.0', 24],
      ['224.0.0.0', 4],
      ['240.0.0.0', 4]
    ];

    return !blockedRanges.some(([network, prefix]) =>
      inIPv4Range(address, network, prefix)
    );
  }

  if (version === 6) {
    const groups = expandIPv6(address);

    if (!groups) return false;

    // Only consider global-unicast space.
    if (groups[0] < 0x2000 || groups[0] > 0x3fff) {
      return false;
    }

    // Exclude special-purpose and documentation ranges.
    if (
      (groups[0] === 0x2001 && groups[1] <= 0x01ff) ||
      (groups[0] === 0x2001 && groups[1] === 0x0db8) ||
      (groups[0] === 0x2002) ||
      (groups[0] === 0x3fff && (groups[1] & 0xfff0) === 0x0000)
    ) {
      return false;
    }

    return true;
  }

  return false;
}

async function resolvePublicHost(hostname) {
  const cleanHost = validHostname(hostname);

  if (net.isIP(cleanHost)) {
    if (!isPublicAddress(cleanHost)) {
      throw new Error(
        'Connections to private, local or reserved IP addresses are blocked.'
      );
    }

    return [{
      address: cleanHost,
      family: net.isIP(cleanHost)
    }];
  }

  const records = await dns.lookup(cleanHost, {
    all: true,
    verbatim: true
  });

  if (!records.length) {
    throw new Error('No IP addresses were returned for this hostname.');
  }

  if (records.some(record => !isPublicAddress(record.address))) {
    throw new Error(
      'The hostname resolves to a private, local or reserved IP address. Request blocked.'
    );
  }

  return records;
}

function checkTcpAddress(address, family, port, timeout = 5000) {
  return new Promise(resolve => {
    const socket = net.createConnection({
      host: address,
      family,
      port
    });

    let finished = false;

    const finish = result => {
      if (finished) return;
      finished = true;
      socket.destroy();
      resolve(result);
    };

    socket.setTimeout(timeout);

    socket.once('connect', () => {
      finish({
        reachable: true,
        message: `Connection established with ${address}:${port}.`
      });
    });

    socket.once('timeout', () => {
      finish({
        reachable: false,
        message: 'Connection timed out.'
      });
    });

    socket.once('error', error => {
      finish({
        reachable: false,
        message: error.code ?? error.message
      });
    });
  });
}

async function checkDirectory(directory) {
  try {
    const stats = await fs.stat(directory);

    if (!stats.isDirectory()) {
      return {
        exists: true,
        directory: false,
        readable: false,
        writable: false
      };
    }

    let readable = false;
    let writable = false;

    try {
      await fs.access(directory, fs.constants.R_OK);
      readable = true;
    } catch {}

    try {
      await fs.access(directory, fs.constants.W_OK);
      writable = true;
    } catch {}

    return {
      exists: true,
      directory: true,
      readable,
      writable
    };
  } catch (error) {
    return {
      exists: false,
      directory: false,
      readable: false,
      writable: false,
      error: error.code ?? error.message
    };
  }
}

export const commands = [
  makeCommand('serverinfo', 'Display an overview of the host operating system.', async () => {
    return [
      '*SERVER INFORMATION*',
      `Hostname: ${os.hostname()}`,
      `Operating system: ${os.type()}`,
      `Platform: ${os.platform()}`,
      `Architecture: ${os.arch()}`,
      `OS release: ${os.release()}`,
      `CPU cores: ${os.cpus().length}`,
      `System uptime: ${formatDuration(os.uptime())}`,
      `Node.js: ${process.version}`
    ].join('\n');
  }),

  makeCommand('cpuinfo', 'Display processor model and core information.', async () => {
    const cpus = os.cpus();

    return [
      '*CPU INFORMATION*',
      `Model: ${cpus[0]?.model ?? 'Unavailable'}`,
      `Logical cores: ${cpus.length}`,
      `Reported speed: ${cpus[0]?.speed ?? 0} MHz`,
      `Architecture: ${os.arch()}`,
      `Platform: ${os.platform()}`
    ].join('\n');
  }),

  makeCommand('memory', 'Display system memory usage.', async () => {
    const total = os.totalmem();
    const free = os.freemem();
    const used = total - free;
    const percentage = total ? ((used / total) * 100).toFixed(1) : '0';

    return [
      '*SYSTEM MEMORY*',
      `Total: ${formatBytes(total)}`,
      `Used: ${formatBytes(used)}`,
      `Free: ${formatBytes(free)}`,
      `Usage: ${percentage}%`
    ].join('\n');
  }),

  makeCommand('diskspace', 'Display available disk space for the application filesystem.', async () => {
    const stats = await fs.statfs(process.cwd());
    const total = Number(stats.blocks) * Number(stats.bsize);
    const free = Number(stats.bavail) * Number(stats.bsize);
    const used = Math.max(0, total - free);
    const percentage = total ? ((used / total) * 100).toFixed(1) : '0';

    return [
      '*DISK SPACE*',
      `Filesystem location: ${process.cwd()}`,
      `Total: ${formatBytes(total)}`,
      `Used: ${formatBytes(used)}`,
      `Available: ${formatBytes(free)}`,
      `Usage: ${percentage}%`
    ].join('\n');
  }),

  makeCommand('uptime', 'Display operating system and bot process uptime.', async () => {
    return [
      '*UPTIME*',
      `System uptime: ${formatDuration(os.uptime())}`,
      `Bot process uptime: ${formatDuration(process.uptime())}`
    ].join('\n');
  }),

  makeCommand('loadavg', 'Display the operating system load averages.', async () => {
    const values = os.loadavg();

    return [
      '*SYSTEM LOAD AVERAGE*',
      `1 minute: ${values[0].toFixed(2)}`,
      `5 minutes: ${values[1].toFixed(2)}`,
      `15 minutes: ${values[2].toFixed(2)}`,
      `Logical CPU cores: ${os.cpus().length}`,
      os.platform() === 'win32'
        ? 'Note: Windows does not provide standard load averages; these values may be zero.'
        : 'These figures represent system load, not CPU usage percentages.'
    ].join('\n');
  }),

  makeCommand('nodeversion', 'Display the installed Node.js and V8 versions.', async () => {
    return [
      '*NODE.JS VERSION*',
      `Node.js: ${process.version}`,
      `V8: ${process.versions.v8}`,
      `NPM: ${process.env.npm_config_user_agent?.split('/')[1]?.split(' ')[0] ?? 'Not available in this process'}`
    ].join('\n');
  }),

  makeCommand('platform', 'Display the host operating system platform.', async () => {
    return [
      `Platform: ${process.platform}`,
      `Operating system: ${os.type()}`,
      `Release: ${os.release()}`,
      `Version: ${os.version()}`
    ].join('\n');
  }),

  makeCommand('architecture', 'Display the server CPU architecture.', async () => {
    return [
      `Process architecture: ${process.arch}`,
      `Operating system architecture: ${os.arch()}`,
      `Platform: ${process.platform}`
    ].join('\n');
  }),

  makeCommand('hostname', 'Display the server hostname.', async () => {
    return `Server hostname: ${os.hostname()}`;
  }),

  makeCommand('processinfo', 'Display information about the running bot process.', async () => {
    const memory = process.memoryUsage();

    return [
      '*BOT PROCESS INFORMATION*',
      `PID: ${process.pid}`,
      `Node.js: ${process.version}`,
      `Process uptime: ${formatDuration(process.uptime())}`,
      `Working directory: ${process.cwd()}`,
      `RSS: ${formatBytes(memory.rss)}`,
      `Heap used: ${formatBytes(memory.heapUsed)}`,
      `Heap total: ${formatBytes(memory.heapTotal)}`,
      `External memory: ${formatBytes(memory.external)}`
    ].join('\n');
  }),

  makeCommand('heapinfo', 'Display V8 JavaScript heap usage.', async () => {
    const memory = process.memoryUsage();

    return [
      '*V8 HEAP INFORMATION*',
      `Heap used: ${formatBytes(memory.heapUsed)}`,
      `Heap allocated: ${formatBytes(memory.heapTotal)}`,
      `Heap available within current allocation: ${formatBytes(Math.max(0, memory.heapTotal - memory.heapUsed))}`,
      `RSS: ${formatBytes(memory.rss)}`,
      `External: ${formatBytes(memory.external)}`,
      `Array buffers: ${formatBytes(memory.arrayBuffers)}`
    ].join('\n');
  }),

  makeCommand('envstatus', 'Check whether essential configuration variables are present without revealing their values.', async () => {
    const variables = [
      'NODE_ENV',
      'PORT',
      'BOT_NAME',
      'PAIRING_NUMBER',
      'OWNER_NUMBER',
      'SESSION_DIR'
    ];

    return [
      '*CONFIGURATION STATUS*',
      ...variables.map(name =>
        `${name}: ${process.env[name]?.trim() ? 'Configured' : 'Not configured'}`
      ),
      '',
      'Secret values are never displayed.'
    ].join('\n');
  }, OWNER),

  makeCommand('packageinfo', 'Display the project package name, version and declared runtime.', async () => {
    const packagePath = path.join(process.cwd(), 'package.json');
    const data = JSON.parse(await fs.readFile(packagePath, 'utf8'));

    return [
      '*PROJECT PACKAGE INFORMATION*',
      `Name: ${data.name ?? 'Not specified'}`,
      `Version: ${data.version ?? 'Not specified'}`,
      `Description: ${data.description ?? 'Not specified'}`,
      `Entry point: ${data.main ?? 'Not specified'}`,
      `Module type: ${data.type ?? 'CommonJS default'}`,
      `Required Node.js: ${data.engines?.node ?? 'Not specified'}`
    ].join('\n');
  }, OWNER),

  makeCommand('dependencycheck', 'Check whether declared project dependencies can be resolved.', async () => {
    const packagePath = path.join(process.cwd(), 'package.json');
    const data = JSON.parse(await fs.readFile(packagePath, 'utf8'));
    const dependencies = Object.keys(data.dependencies ?? {});

    if (!dependencies.length) {
      return 'No production dependencies are declared in package.json.';
    }

    const results = dependencies.map(name => {
      try {
        require.resolve(name);
        return `✅ ${name}: available`;
      } catch {
        return `❌ ${name}: not found`;
      }
    });

    return [
      '*DEPENDENCY CHECK*',
      ...results,
      '',
      `Dependencies checked: ${dependencies.length}`
    ].join('\n');
  }, OWNER),

  makeCommand('networkinterfaces', 'Display available network interface addresses.', async () => {
    const interfaces = os.networkInterfaces();
    const lines = [];

    for (const [name, records] of Object.entries(interfaces)) {
      for (const record of records ?? []) {
        if (record.internal) continue;
        lines.push(`${name}: ${record.family} ${record.address}`);
      }
    }

    return lines.length
      ? `*NETWORK INTERFACES*\n${lines.join('\n')}`
      : 'No non-internal network interface addresses were reported.';
  }, OWNER),

  makeCommand('dnslookup', 'Resolve DNS addresses for a public hostname and reject private or reserved results.', async ctx => {
    const [input] = getArgs(ctx);

    if (!input) {
      throw new Error('Usage: .dnslookup example.com');
    }

    const hostname = validHostname(input);
    const records = await resolvePublicHost(hostname);

    return [
      `*PUBLIC DNS LOOKUP: ${hostname}*`,
      ...records.map(record =>
        `${record.family === 4 ? 'IPv4' : 'IPv6'}: ${record.address}`
      )
    ].join('\n');
  }),

  makeCommand('tcpcheck', 'Check whether a public hostname accepts a TCP connection on a port.', async ctx => {
    const [input, portInput] = getArgs(ctx);

    if (!input || !portInput) {
      throw new Error('Usage: .tcpcheck example.com 443');
    }

    const port = validPort(portInput);
    const records = await resolvePublicHost(input);
    const result = await checkTcpAddress(
      records[0].address,
      records[0].family,
      port
    );

    return [
      '*TCP CONNECTION CHECK*',
      `Host: ${input}`,
      `Port: ${port}`,
      `Resolved address: ${records[0].address}`,
      result.reachable ? 'Status: Reachable' : 'Status: Not reachable',
      `Result: ${result.message}`
    ].join('\n');
  }),

  makeCommand('localport', 'Check whether a TCP port is accepting connections on the local server.', async ctx => {
    const [portInput] = getArgs(ctx);

    if (!portInput) {
      throw new Error('Usage: .localport 3000');
    }

    const port = validPort(portInput);
    const result = await checkTcpAddress('127.0.0.1', 4, port, 3000);

    return [
      '*LOCAL PORT CHECK*',
      'Address: 127.0.0.1',
      `Port: ${port}`,
      result.reachable ? 'Status: Open' : 'Status: Closed or unavailable',
      `Result: ${result.message}`
    ].join('\n');
  }),

  makeCommand('storagecheck', 'Check read and write access to the application storage directory.', async () => {
    const directory = path.resolve(process.cwd(), 'data');
    const result = await checkDirectory(directory);

    return [
      '*STORAGE DIRECTORY CHECK*',
      `Directory: ${directory}`,
      `Exists: ${result.exists ? 'Yes' : 'No'}`,
      `Is directory: ${result.directory ? 'Yes' : 'No'}`,
      `Readable: ${result.readable ? 'Yes' : 'No'}`,
      `Writable: ${result.writable ? 'Yes' : 'No'}`,
      result.error ? `Error: ${result.error}` : null,
      '',
      'This check does not create or modify files.'
    ].filter(Boolean).join('\n');
  }, OWNER),

  makeCommand('sessionstatus', 'Check whether the WhatsApp session directory exists and is accessible.', async () => {
    const configured = process.env.SESSION_DIR || './sessions';
    const directory = path.resolve(process.cwd(), configured);
    const result = await checkDirectory(directory);

    return [
      '*WHATSAPP SESSION DIRECTORY*',
      `Directory: ${directory}`,
      `Exists: ${result.exists ? 'Yes' : 'No'}`,
      `Is directory: ${result.directory ? 'Yes' : 'No'}`,
      `Readable: ${result.readable ? 'Yes' : 'No'}`,
      `Writable: ${result.writable ? 'Yes' : 'No'}`,
      result.error ? `Error: ${result.error}` : null,
      '',
      'This checks directory access only; it does not verify WhatsApp authentication.'
    ].filter(Boolean).join('\n');
  }, OWNER),

  makeCommand('logstatus', 'Check whether the application log directory is accessible.', async () => {
    const directory = path.resolve(process.cwd(), 'logs');
    const result = await checkDirectory(directory);

    return [
      '*LOG DIRECTORY STATUS*',
      `Directory: ${directory}`,
      `Exists: ${result.exists ? 'Yes' : 'No'}`,
      `Is directory: ${result.directory ? 'Yes' : 'No'}`,
      `Readable: ${result.readable ? 'Yes' : 'No'}`,
      `Writable: ${result.writable ? 'Yes' : 'No'}`,
      result.error ? `Error: ${result.error}` : null,
      '',
      'This command checks directory access; it does not read log contents.'
    ].filter(Boolean).join('\n');
  }, OWNER),

  makeCommand('runtimecheck', 'Check basic Node.js runtime compatibility and process details.', async () => {
    const [major, minor] = process.versions.node.split('.').map(Number);
    const compatible = major > 22 || (major === 22 && minor >= 13);

    return [
      '*RUNTIME CHECK*',
      `Installed Node.js: ${process.version}`,
      'Recommended minimum for this project: Node.js 22.13',
      `Version check: ${compatible ? 'Pass' : 'Below recommended minimum'}`,
      'Module system: ES modules',
      `Process architecture: ${process.arch}`,
      `Platform: ${process.platform}`,
      '',
      'This is a version check, not a complete dependency or deployment test.'
    ].join('\n');
  }, OWNER),

  makeCommand('pathstatus', 'Inspect the existence of important application directories.', async () => {
    const paths = [
      ['Project root', process.cwd()],
      ['Source directory', path.join(process.cwd(), 'src')],
      ['Commands directory', path.join(process.cwd(), 'src', 'commands')],
      ['Database directory', path.join(process.cwd(), 'src', 'db')],
      ['Tests directory', path.join(process.cwd(), 'tests')],
      ['Session directory', path.resolve(process.cwd(), process.env.SESSION_DIR || './sessions')]
    ];

    const results = await Promise.all(
      paths.map(async ([label, directory]) => {
        const result = await checkDirectory(directory);

        return `${label}: ${result.directory ? 'Available' : 'Missing or inaccessible'}\n${directory}`;
      })
    );

    return `*APPLICATION PATH STATUS*\n${results.join('\n\n')}`;
  }, OWNER),

  makeCommand('serverdate', 'Display the server date and time with its configured timezone.', async () => {
    const now = new Date();

    return [
      '*SERVER DATE AND TIME*',
      `Local time: ${now.toString()}`,
      `UTC time: ${now.toISOString()}`,
      `Timezone: ${Intl.DateTimeFormat().resolvedOptions().timeZone}`,
      `Unix timestamp: ${Math.floor(now.getTime() / 1000)}`
    ].join('\n');
  })
];
