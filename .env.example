
# MUNAISZN X configuration

NODE_ENV=production
PORT=3000
BOT_NAME=MUNAISZN X
LOG_LEVEL=info

# WhatsApp pairing number
# International format, digits only, no + sign.
# Never share your pairing code publicly.
PAIRING_NUMBER=

# WhatsApp session storage
SESSION_DIR=./sessions

# Owner number, international format, digits only
OWNER_NUMBER=

# Optional AI provider
# Leave blank until a compatible provider is configured.
AI_API_URL=
AI_API_KEY=
